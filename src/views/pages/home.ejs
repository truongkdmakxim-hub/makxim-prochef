<%- include('../partials/head', {
  jsonLd: {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Makxim ProChef',
    url: baseUrl,
    logo: baseUrl + '/img/logo.png',
    contactPoint: { '@type': 'ContactPoint', telephone: shop.hotline, contactType: 'customer service', areaServed: 'VN', availableLanguage: 'Vietnamese' },
  },
}) %>

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow"><%- icon('sparkles', { size: 16 }) %> Dòng bếp từ Inverter mới</span>
      <h1 class="display">Nấu nhanh hơn.<br>Bếp sạch hơn.<br>An tâm hơn.</h1>
      <p class="lead">Bếp điện từ ProChef mang nhiệt ổn định của công nghệ Inverter vào gian bếp Việt — tiết kiệm điện đến 10%, an toàn tuyệt đối cho trẻ nhỏ.</p>
      <div class="hero-cta">
        <a class="btn btn-accent btn-lg" href="/bep-tu-doi">Mua bếp từ đôi <%- icon('arrow-right', { size: 18 }) %></a>
        <a class="btn btn-outline btn-lg" href="/bep-tu-don">Xem bếp từ đơn</a>
      </div>
      <div class="hero-proof">
        <span class="stars" aria-hidden="true"><% for (let i = 0; i < 5; i++) { %><%- icon('star', { size: 16 }) %><% } %></span>
        <span><b style="color: var(--ink)">4,9/5</b> từ hơn 2.000 gia đình đang dùng ProChef</span>
      </div>
    </div>
    <div class="hero-visual">
      <%#
        ẢNH HERO — ảnh bối cảnh vuông 1:1 (nên ≥ 1400×1400), phủ kín khung. Thay ảnh: đổi đường dẫn /img/hero-scene.webp bên dưới.
        Chừa trống góc trên trái và 2 góc dưới cho 3 thẻ thông số. Ảnh cũ (sản phẩm nền trong suốt) vẫn ở /img/hero-cooktop.*
      %>
      <div class="stage stage-scene">
        <div class="scene">
          <img src="/img/hero-scene.webp" alt="Bếp từ đôi Makxim ProChef Inverter lắp âm trên mặt bếp đá cẩm thạch" width="1400" height="1400" fetchpriority="high">
          <%# Vòng sáng vùng nấu (đo theo vòng nét đứt trong ảnh): --x, --y = tâm; --w, --h = 2 trục elip (% ảnh); --r = góc xoay. Đổi ảnh thì phải đo lại. %>
          <span class="scene-glow" style="--x: 33.83%; --y: 60.98%; --w: 18.51%; --h: 14.4%; --r: -13.2deg" aria-hidden="true"></span>
          <span class="scene-glow" style="--x: 58.46%; --y: 44.93%; --w: 17.53%; --h: 13.47%; --r: -7.1deg; --delay: -1.6s" aria-hidden="true"></span>
        </div>
      </div>
      <div class="spec-float f1"><span class="ico"><%- icon('zap', { size: 18 }) %></span><span><b>5200W</b>Booster siêu tốc</span></div>
      <div class="spec-float f2"><span class="ico"><%- icon('leaf', { size: 18 }) %></span><span><b>−10%</b>điện năng tiêu thụ</span></div>
      <div class="spec-float f3"><span class="ico"><%- icon('shield', { size: 18 }) %></span><span><b>9 lớp</b>bảo vệ an toàn</span></div>
    </div>
  </div>
</section>

<section class="trust" aria-label="Cam kết dịch vụ">
  <div class="container">
    <div class="trust-panel reveal">
      <div class="trust-item"><span class="ico"><%- icon('truck') %></span><div class="trust-copy"><span class="trust-kicker">Giao toàn quốc</span><b class="trust-fig">0₫<small>phí ship</small></b><span class="trust-sub">Cho đơn từ <%= fmt.money(shop.freeShipFrom) %></span></div></div>
      <div class="trust-item"><span class="ico"><%- icon('shield') %></span><div class="trust-copy"><span class="trust-kicker">Bảo hành</span><b class="trust-fig">36<small>tháng</small></b><span class="trust-sub">Tận nhà tại HN &amp; HCM</span></div></div>
      <div class="trust-item"><span class="ico"><%- icon('rotate') %></span><div class="trust-copy"><span class="trust-kicker">1 đổi 1</span><b class="trust-fig">30<small>ngày</small></b><span class="trust-sub">Nếu lỗi nhà sản xuất</span></div></div>
      <div class="trust-item"><span class="ico"><%- icon('wallet') %></span><div class="trust-copy"><span class="trust-kicker">Thanh toán</span><b class="trust-fig">COD<small>&amp; MoMo</small></b><span class="trust-sub">Kiểm tra hàng trước khi trả</span></div></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow">Hai dòng sản phẩm</span>
        <h2 class="h2">Chọn chiếc bếp hợp với nhà bạn</h2>
      </div>
      <a class="link" href="/so-sanh">So sánh chi tiết <%- icon('arrow-right', { size: 16 }) %></a>
    </div>
    <div class="lines">
      <a class="line-card photo reveal" href="/bep-tu-don">
        <div class="copy">
          <span class="eyebrow">Bếp từ đơn</span>
          <h3 class="h2">Nhỏ gọn. Linh hoạt.</h3>
          <p class="price-from">Từ <b><%= fmt.money(ranges.don.min) %></b> · Cho căn hộ, bữa lẩu, bếp phụ</p>
          <span class="link">Khám phá <%- icon('arrow-right', { size: 16 }) %></span>
        </div>
        <img src="/img/home/bep-tu-don.webp" alt="Bộ ba bếp từ đơn ProChef trên mặt bếp đá" width="1200" height="1420" loading="lazy">
      </a>
      <a class="line-card dark photo reveal" href="/bep-tu-doi" style="--d: 100ms">
        <div class="copy">
          <span class="eyebrow" style="color: #fdba74">Bếp từ đôi</span>
          <h3 class="h2">Hai vùng nấu. Một bữa trọn vẹn.</h3>
          <p class="price-from">Từ <b><%= fmt.money(ranges.doi.min) %></b> · Cho gia đình 3 – 6 người</p>
          <span class="link">Khám phá <%- icon('arrow-right', { size: 16 }) %></span>
        </div>
        <img src="/img/home/bep-tu-doi.webp" alt="Bếp từ đôi ProChef đang nấu trên mặt bếp" width="1400" height="1292" loading="lazy">
      </a>
    </div>
  </div>
</section>

<section class="section" style="padding-top: 0" id="san-pham-noi-bat">
  <div class="container">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow">Bán chạy nhất</span>
        <h2 class="h2">Sản phẩm nổi bật</h2>
      </div>
      <div class="segmented" role="tablist" aria-label="Lọc theo dòng bếp" data-filter-tabs>
        <button type="button" role="tab" aria-selected="true" data-filter="all">Tất cả</button>
        <button type="button" role="tab" aria-selected="false" data-filter="don">Bếp đơn</button>
        <button type="button" role="tab" aria-selected="false" data-filter="doi">Bếp đôi</button>
      </div>
    </div>
    <div class="product-grid" data-filter-grid>
      <% featured.forEach((p, index) => { %>
        <div data-line="<%= p.line %>" style="display: contents"><%- include('../partials/product-card', { p, index }) %></div>
      <% }) %>
    </div>
  </div>
</section>

<section class="section" style="background: var(--surface); border-block: 1px solid var(--border)">
  <div class="container">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow">Công nghệ ProChef</span>
        <h2 class="h2">Mọi chi tiết đều vì bữa cơm nhà bạn</h2>
        <p class="lead">Không chỉ nóng nhanh — ProChef được thiết kế để nấu ngon, dùng bền và an toàn trong từng lần bật bếp.</p>
      </div>
    </div>
    <div class="bento">
      <div class="tile hero-tile reveal">
        <div class="inv-stage">
          <div class="inv-cooktop" aria-hidden="true">
            <div class="inv-glass">
              <img src="/img/hero-cooktop.webp" alt="" width="1400" height="825" loading="lazy">
              <span class="inv-zone z-left"></span>
              <span class="inv-zone z-right"></span>
            </div>
            <span class="inv-shadow"></span>
          </div>
          <span class="inv-badge"><i></i>Inverter · Mức 2 · liu riu</span>
        <figure class="inv-chart" aria-label="Biểu đồ so sánh công suất: bếp từ thường bật tắt liên tục, ProChef Inverter giữ công suất thấp ổn định">
          <figcaption class="inv-legend">
            <span class="inv-key on-off"><i></i>Bếp từ thường · bật – tắt</span>
            <span class="inv-key inverter"><i></i>ProChef Inverter · êm, đều</span>
          </figcaption>
          <div class="inv-plot">
          <svg viewBox="0 0 600 220" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <linearGradient id="invFill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#ff6a1a" stop-opacity=".32"/>
                <stop offset="1" stop-color="#ff6a1a" stop-opacity="0"/>
              </linearGradient>
              <linearGradient id="invStroke" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#ff6a1a"/>
                <stop offset="1" stop-color="#c2410c"/>
              </linearGradient>
            </defs>
            <g class="inv-grid">
              <line x1="0" y1="40" x2="600" y2="40"/><line x1="0" y1="95" x2="600" y2="95"/><line x1="0" y1="200" x2="600" y2="200"/>
            </g>
            <line class="inv-target" x1="0" y1="148" x2="600" y2="148"/>
            <path class="inv-onoff" pathLength="1" d="M0 200 V40 H55 V200 H105 V40 H160 V200 H210 V40 H265 V200 H315 V40 H370 V200 H420 V40 H475 V200 H525 V40 H580 V200 H600"/>
            <path class="inv-area" d="M0 200 C40 200 50 148 90 148 S170 146 210 149 S300 150 340 147 S440 146 480 149 S560 148 600 148 V220 H0 Z" fill="url(#invFill)"/>
            <path class="inv-line" pathLength="1" d="M0 200 C40 200 50 148 90 148 S170 146 210 149 S300 150 340 147 S440 146 480 149 S560 148 600 148" stroke="url(#invStroke)"/>
          </svg>
          <span class="inv-tag t-max">100% công suất</span>
          <span class="inv-tag t-low">Liu riu ổn định</span>
          <span class="inv-tag t-off">0%</span>
          </div>
        </figure>
        </div>
        <div class="inv-copy">
          <div class="big-num"><b>10<small>%</small></b><span>tiết kiệm điện</span></div>
          <div>
            <h3>Inverter — lửa nhỏ thật sự nhỏ</h3>
            <p>Thay vì bật – tắt liên tục như bếp từ thường, mạch Inverter điều chỉnh công suất mượt mà. Nồi nước dùng liu riu cả buổi, món kho không cháy đáy.</p>
          </div>
        </div>
      </div>
      <div class="tile reveal" style="--d: 80ms"><span class="ico"><%- icon('zap') %></span><h3>Booster đun sôi siêu tốc</h3><p>2 lít nước sôi trong khoảng 5 phút — nhanh gấp đôi bếp gas.</p></div>
      <div class="tile reveal" style="--d: 160ms"><span class="ico"><%- icon('lock') %></span><h3>Khóa trẻ em</h3><p>Chạm giữ 3 giây để khóa bảng điều khiển — bé nghịch cũng không bật được.</p></div>
      <div class="tile reveal"><span class="ico"><%- icon('thermometer') %></span><h3>Cảnh báo mặt bếp nóng</h3><p>Biểu tượng “H” sáng cho đến khi mặt kính nguội hẳn.</p></div>
      <div class="tile reveal" style="--d: 80ms"><span class="ico"><%- icon('droplets') %></span><h3>Cảm biến chống trào</h3><p>Tự hạ công suất khi nước tràn lên mặt kính, tránh cháy nồi.</p></div>
      <div class="tile accent-tile reveal" style="--d: 160ms"><span class="ico"><%- icon('sparkles') %></span><h3>Lau sạch trong 10 giây</h3><p>Mặt kính ceramic phẳng tuyệt đối — không khe, không chân kiềng, không muội than.</p></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow">Tư vấn nhanh</span>
        <h2 class="h2">Bếp đơn hay bếp đôi?</h2>
      </div>
    </div>
    <div class="guide">
      <div class="guide-card reveal">
        <div class="head"><h3 class="h3">Bếp từ đơn phù hợp nếu bạn…</h3><span class="chip">Từ <%= fmt.money(ranges.don.min) %></span></div>
        <ul>
          <li><%- icon('check', { size: 18 }) %>Ở căn hộ nhỏ, phòng trọ hoặc sống một – hai người</li>
          <li><%- icon('check', { size: 18 }) %>Cần bếp phụ để ăn lẩu, nấu nhanh bên cạnh bếp chính</li>
          <li><%- icon('check', { size: 18 }) %>Muốn di chuyển, cất gọn khi không dùng</li>
        </ul>
        <a class="btn btn-outline" href="/bep-tu-don">Xem bếp từ đơn</a>
      </div>
      <div class="guide-card reveal" style="--d: 100ms">
        <div class="head"><h3 class="h3">Bếp từ đôi phù hợp nếu bạn…</h3><span class="chip">Từ <%= fmt.money(ranges.doi.min) %></span></div>
        <ul>
          <li><%- icon('check', { size: 18 }) %>Nấu cơm hằng ngày cho gia đình từ 3 người trở lên</li>
          <li><%- icon('check', { size: 18 }) %>Muốn nấu canh và xào cùng lúc, lên mâm nóng hổi</li>
          <li><%- icon('check', { size: 18 }) %>Đang làm tủ bếp mới, cần bếp lắp âm mặt đá</li>
        </ul>
        <a class="btn btn-primary" href="/bep-tu-doi">Xem bếp từ đôi</a>
      </div>
    </div>
  </div>
</section>

<section class="section" style="padding-top: 0">
  <div class="container">
    <div class="stats">
      <div class="stat reveal"><b>2.000+</b><span>gia đình tin dùng</span></div>
      <div class="stat reveal" style="--d: 80ms"><b>36</b><span>tháng bảo hành tối đa</span></div>
      <div class="stat reveal" style="--d: 160ms"><b>34</b><span>tỉnh thành giao hàng</span></div>
      <div class="stat reveal" style="--d: 240ms"><b>4,9★</b><span>đánh giá trung bình</span></div>
    </div>
  </div>
</section>

<% if (reviews.length) { %>
<section class="section" style="padding-top: 0">
  <div class="container">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow">Khách hàng nói gì</span>
        <h2 class="h2">Được yêu thích trong hàng nghìn gian bếp</h2>
      </div>
    </div>
    <div class="reviews">
      <% reviews.forEach((r, i) => { %>
        <figure class="review reveal" style="--d: <%= i * 80 %>ms; margin: 0">
          <span class="stars" aria-label="<%= r.rating %> trên 5 sao"><% for (let s = 0; s < r.rating; s++) { %><%- icon('star', { size: 16 }) %><% } %></span>
          <blockquote>“<%= r.text %>”</blockquote>
          <footer>
            <span class="avatar" aria-hidden="true"><%= r.name.split(' ').pop()[0] %></span>
            <div><b><%= r.name %></b><span><%= [r.place, r.product].filter(Boolean).join(' · ') %></span></div>
          </footer>
        </figure>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section" style="padding-top: 0" id="faq">
  <div class="container faq-wrap">
    <div class="sticky reveal">
      <span class="eyebrow">Câu hỏi thường gặp</span>
      <h2 class="h2">Mọi điều bạn cần biết trước khi mua</h2>
      <p class="lead">Chưa tìm thấy câu trả lời? Gọi <a class="link" href="tel:<%= shop.hotline.replace(/\s/g, '') %>"><%= shop.hotline %></a> — tư vấn miễn phí.</p>
    </div>
    <div class="faq reveal">
      <% faqs.forEach((f, i) => { %>
        <details <%= i === 0 ? 'open' : '' %>>
          <summary><%= f.q %><%- icon('plus', { size: 20 }) %></summary>
          <p><%= f.a %></p>
        </details>
      <% }) %>
    </div>
  </div>
</section>

<section class="container">
  <div class="cta-band reveal">
    <div>
      <h2 class="h2">Cần tư vấn chọn bếp?</h2>
      <p>Kỹ thuật viên ProChef sẽ gợi ý model phù hợp với gian bếp, đường điện và thói quen nấu nướng của gia đình bạn — hoàn toàn miễn phí.</p>
    </div>
    <div class="actions">
      <a class="btn btn-accent btn-lg" href="tel:<%= shop.hotline.replace(/\s/g, '') %>"><%- icon('phone', { size: 18 }) %> <%= shop.hotline %></a>
      <% if (shop.zaloUrl) { %><a class="btn btn-outline btn-lg" href="<%= shop.zaloUrl %>" target="_blank" rel="noopener">Chat Zalo</a><% } else { %><a class="btn btn-outline btn-lg" href="/lien-he">Liên hệ</a><% } %>
    </div>
  </div>
</section>

<%- include('../partials/foot') %>
