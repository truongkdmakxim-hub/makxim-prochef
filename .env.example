# ---------------------------------------------------------------
# Makxim ProChef — biến môi trường
# Local: copy thành .env   |   Hostinger: nhập trong hPanel > Node.js > Environment variables
# ---------------------------------------------------------------

NODE_ENV=production
PORT=3000
# URL công khai của website (không có dấu / ở cuối) — dùng cho MoMo redirect/IPN, sitemap, SEO
BASE_URL=https://prochef.makxim.vn
# Chuỗi ngẫu nhiên dài >= 32 ký tự. Tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Database ----
# Bỏ trống DB_HOST => dùng SQLite (chỉ nên dùng khi dev local)
DB_CLIENT=mysql2
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# ---- Tài khoản quản trị (tạo ở lần chạy đầu) ----
ADMIN_EMAIL=admin@makxim.vn
ADMIN_PASSWORD=

# ---- MoMo (bỏ trống => ẩn thanh toán MoMo) ----
# Sandbox: https://test-payment.momo.vn   |   Production: https://payment.momo.vn
MOMO_ENDPOINT=https://test-payment.momo.vn
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# captureWallet (ví MoMo) hoặc payWithMethod (ví + ATM/thẻ qua MoMo)
MOMO_REQUEST_TYPE=captureWallet

# ---- Email thông báo đơn hàng (Hostinger Email: smtp.hostinger.com, 465) ----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Makxim ProChef <no-reply@makxim.vn>"

# ---- Thông tin cửa hàng ----
SHOP_LEGAL_NAME=Công ty CPTM&XNK Makxim Việt Nam
SHOP_HOTLINE=1900 599 894
SHOP_EMAIL=kinhdoanh@makxim.vn
SHOP_ADDRESS=Lô CN2 cụm Công nghiệp Ngọc Hồi, Hà Nội, Việt Nam
SHOP_HOURS=8:00 – 21:00, Thứ 2 – Chủ nhật
ZALO_URL=https://zalo.me/0972956068
MESSENGER_URL=https://m.me/509122598949574
SHIPPING_FEE=100000
FREE_SHIP_FROM=5000000

# Thư mục lưu ảnh upload từ Admin (nên đặt ngoài thư mục code để không mất khi redeploy)
# UPLOAD_DIR=/home/uXXXX/prochef-uploads
